# =============================================================================
# WritePilot environment
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real values: .env* is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API. The anon key is safe in the browser; Row Level
# Security is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SECRET. Bypasses Row Level Security completely. Server-side only — it is used
# for credit, subscription and usage operations users must not perform
# themselves. Never prefix it with NEXT_PUBLIC_ and never reference it from a
# Client Component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Application -------------------------------------------------------------
# Absolute origin. Auth redirect URLs are built from this and must match the
# entries in Supabase -> Authentication -> URL Configuration exactly.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Transactional email (Resend) --------------------------------------------
# Optional. Without these the app runs normally and email sending is skipped
# with a warning rather than failing a request.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="WritePilot <notifications@yourdomain.com>"
RESEND_REPLY_TO_EMAIL=""

# --- AI provider --------------------------------------------------------------
# Server-side only; never exposed to the browser. Without a key the app runs
# normally and every AI tool reports itself as unavailable rather than failing
# mid-request — no credits are charged.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Overridable so the model can be changed without a deploy.
AI_MODEL="claude-opus-5"
# Upper bound on a single analysis, in milliseconds.
AI_TIMEOUT_MS="120000"

# =============================================================================
# Payments (Stripe). Optional.
# -----------------------------------------------------------------------------
# Without these the plan catalogue is still shown and every purchase path
# reports itself as unavailable — nothing pretends to take money it cannot.
#
# STRIPE_SECRET_KEY      Secret API key (sk_test_… while developing).
# STRIPE_WEBHOOK_SECRET  Signing secret for the endpoint you register at
#                        <your origin>/api/webhooks/stripe. Without it no
#                        webhook is accepted at all: an unverified body is an
#                        unauthenticated instruction to grant credits.
#
# Price ids are NOT environment variables. They live in the `plans` and
# `credit_packs` tables (provider_price_id_monthly, provider_price_id_yearly,
# provider_price_id) so repricing is a data change, not a deploy.
#
# Events the endpoint acts on, and which to enable when registering it:
#   checkout.session.completed
#   customer.subscription.created / .updated / .deleted
#   invoice.paid
# =============================================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
